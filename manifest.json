{
  "manifest_version": 3,
  "name": "空き時間コピーくん",
  "version": "0.2.0",
  "description": "Googleカレンダー上でドラッグ選択した空き時間帯を一覧にまとめ、コピー用の箇条書きテキストを作成します。",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "空き時間コピーくんパネルの表示/最小化を切り替え"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content/panel.js"],
      "run_at": "document_idle"
    }
  ]
}
