{
  "manifest_version": 3,
  "name": "GCal 空き時間コピー",
  "version": "0.1.0",
  "description": "Googleカレンダーの週表示から空き時間を検出し、コピー用の箇条書きテキストを生成します。",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": []
}
